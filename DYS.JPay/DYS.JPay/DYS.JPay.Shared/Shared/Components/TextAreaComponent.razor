

<label class="text-xs text-on-surface-variant uppercase tracking-wider pl-1">@Label</label>
<textarea id="@Id" readonly="@ReadOnly" @oninput="@OnTextChanged" @bind="@Item" type="text" required placeholder="@PlaceHolder" class="w-full px-5 py-2 @Style border-none rounded-2xl text-sm focus:ring-2 focus:ring-primary transition-all outline-none" />

@code {
    [Parameter]
    public string Id { get; set; } = "text-area-1";
    [Parameter]
    public string Label { get; set; } = "Label here";
    [Parameter]
    public string PlaceHolder { get; set; } = "e.g. add short description";
    [Parameter]
    public string Item { get; set; } = string.Empty;
    [Parameter]
    public string Style { get; set; } = "bg-surface-container-low";
    [Parameter]
    public bool ReadOnly { get; set; } = false;
    [Parameter]
    public EventCallback<string> ItemChanged { get; set; }

    public void OnTextChanged(ChangeEventArgs e)
    {
        var text = e.Value != null ? e.Value.ToString() : string.Empty;
        ItemChanged.InvokeAsync(text);
    }

}
