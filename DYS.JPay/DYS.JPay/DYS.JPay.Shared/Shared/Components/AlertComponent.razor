@if (Notification.Success == true)
{
    <div class="flex items-center px-3 py-3 mb-4 text-sm text-green-700 bg-green-100 rounded-lg" role="alert">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 00-1.414 0L9 11.586 6.707 9.293a1 1 0 00-1.414 1.414l3 3a1 1 0 001.414 0l7-7a1 1 0 000-1.414z" clip-rule="evenodd" />
        </svg>
        <small class="text-sm">@Notification.Description</small>
    </div>
}
else if (Notification.Success == false)
{
    <div class="flex items-center px-3 py-3 mb-4 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-1-11h2v5h-2V7zm0 6h2v2h-2v-2z" clip-rule="evenodd" />
        </svg>
        <small class="text-sm">@Notification.Description</small>
    </div>
}




@code {
    [Parameter]
    public NotificationDto Notification { get; set; } = new NotificationDto();
}
