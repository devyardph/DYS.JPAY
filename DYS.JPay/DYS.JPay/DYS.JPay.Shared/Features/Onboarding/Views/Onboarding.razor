@page "/onboarding"
@layout EmptyLayout
@using DYS.JPay.Shared.Features.Onboarding.ViewModels
@using DYS.JPay.Shared.Shared.Settings
@using DYS.JPay.Shared.Shared.Helpers
@inject IImageService ImageService
@inject IJSRuntime JS
@inject OnboardingViewModel VM

<div id="main" class="h-full p-4 bg-primary-subtle mx-auto my-auto">
    <main class="flex-1 pt-10 px-4 md:px-8 pb-16 max-w-lg mx-auto w-full opacity-0 space-y-5 animate-fade-in-up bg-surface-container-lowest rounded-[2.5rem] shadow-sm border border-outline-variant/10 animate-fade-in">
        <!-- Top Progress -->
        <div class="mb-8 flex justify-between items-center">
            <h2 class="text-3xl font-headline font-black text-primary">Store Setup</h2>
            <div class="flex gap-2">
                <div id="dot-1" class="w-3 h-3 rounded-full bg-primary transition-colors"></div>
                <div id="dot-2" class="w-3 h-3 rounded-full bg-surface-container-highest transition-colors"></div>
                <div id="dot-3" class="w-3 h-3 rounded-full bg-surface-container-highest transition-colors"></div>
                <div id="dot-4" class="w-3 h-3 rounded-full bg-surface-container-highest transition-colors"></div>
            </div>
        </div>

        <!-- Step 1: Store Details -->
        <div id="step-1" class="space-y-6">
            <div class="space-y-2 mb-6">
                <h3 class="text-xl font-bold font-headline text-on-surface">Store Details</h3>
                <p class="text-sm text-on-surface-variant">Let's start by naming your store and setting its identity.</p>
            </div>

            <div class="space-y-4">
                <div class="space-y-1.5">
                    <TextComponent Id="name" @bind-Item="@VM.AppSetting.StoreName" Label="Store Name" PlaceHolder="e.g. stor name" />
                </div>
                <div class="space-y-1.5">
                    <TextAreaComponent Id="description" @bind-Item="@VM.AppSetting.StoreDescription" Label="Store description" PlaceHolder="e.g. store description name" />
                </div>
                <div class="space-y-1.5">
                    <label class="text-xs text-on-surface-variant uppercase tracking-wider pl-1">Currency</label>
                    <select @bind="@VM.AppSetting.Currency"
                            class="w-full bg-surface-container-low border-none rounded-2xl px-5 py-3 text-sm focus:ring-2 focus:ring-primary transition-all">
                        @foreach (var currency in @GlobalSettings.Currencies.OrderBy(x => x.Name)!)
                        {
                            <option value="@currency.DisplayName">@currency.Name - @currency.DisplayName</option>
                        }
                    </select>
                </div>
            </div>
            <button id="btn-next-1" disabled="@(!@VM.AppSetting.ValidContent())" @onclick="@(() => NextAsync(step: "2"))" class="w-full mt-8 ledger-gradient text-white py-4 rounded-2xl font-bold shadow-xl active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                Next Step
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
        </div>

        <!-- Step 2: Store Details -->
        <div id="step-2" class="space-y-6 hidden">
            <div class="space-y-2 mb-6">
                <h3 class="text-xl font-bold font-headline text-on-surface">Owner Details</h3>
                <p class="text-sm text-on-surface-variant">Let's start creating your first account as the owner. You may add other users later on.</p>
            </div>

            <div class="space-y-4">
                <div class="space-y-1.5">
                    <TextComponent Id="name" @bind-Item="@VM.Owner.Name" Label="Owner's name" PlaceHolder="e.g. Mr. Shop" />
                </div>
                <div class="space-y-1.5">
                    <div class="flex justify-between items-center gap-2">
                        <div class="p-1">
                            <TextComponent Id="username" @bind-Item="@VM.Owner.Username" Label="Username" PlaceHolder="e.g. owner" />
                        </div>
                        <div class="p-1">
                            <TextComponent Id="email" @bind-Item="@VM.Owner.Email" Label="Email" PlaceHolder="e.g. email@gmail.com" />
                        </div>
                    </div>
                </div>
                <div class="space-y-1.5">
                    <PasscodeComponent Id="pass-code" @bind-Item="@VM.Owner.Code" Label="6-Digit Code" />
                </div>
            </div>

            <div class="flex gap-4 mt-8">
                <button @onclick="@(() => NextAsync(step: "1"))" class="px-6 py-4 rounded-2xl font-bold text-on-surface-variant bg-surface-container-highest hover:bg-outline-variant/20 transition-all">
                    Back
                </button>
                <button id="btn-next-2" disabled="@(!@VM.Owner.ValidContent())" @onclick="@(() => NextAsync(step: "3"))" class="flex-1 ledger-gradient text-white py-4 rounded-2xl font-bold shadow-xl active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    Save & Continue
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </div>
        </div>

        <!-- Step 3: Add Product -->
        <div id="step-3" class="space-y-6 hidden">
            <div class="space-y-2 mb-6">
                <h3 class="text-xl font-bold font-headline text-on-surface">Add First Product</h3>
                <p class="text-sm text-on-surface-variant">Add at least one product so your store isn't empty.</p>
            </div>

            <div class="space-y-4">
                <div class="space-y-1.5">
                      <TextComponent Id="product-name" @bind-Item="@VM.Product.Name" Label="Product name" PlaceHolder="e.g. Latte" />
                </div>
                <div class="space-y-1.5">
                  
                </div>
                <div class="grid grid-cols-2 gap-4 space-y-1.5">
                    <div class="space-y-1.5">
                        <label class="text-xs text-on-surface-variant uppercase tracking-wider pl-1">Product image</label>
                        <div class="w-full h-50 bg-surface-container-low border border-outline-variant/10 rounded-2xl flex items-center justify-center text-on-surface-variant hover:bg-surface-container-highest transition-colors cursor-pointer group">
                            <button type="button" @onclick="@UploadImageAsync" class="bg-surface-container-lowest rounded-2xl p-2 border border-outline-variant/10 shadow-sm hover:shadow-md hover:border-primary/30 transition-all text-left flex flex-col h-full group w-full">
@*                              <img src="@DataExtensions.GenerateImagePath(VM.Product.ImageUrl)" alt="Demo testing" class="rounded-xl w-full h-full object-cover" referrerpolicy="no-referrer"> *@
                                <ImagePreviewComponent IsBusy="@VM.IsProcessing"  ImageUrl="@VM.Product.TempImageUrl" Style="" />
                            </button>
                        </div>
                     
                    </div>
                    <div class="space-y-1.5">
                        <TextAreaComponent Id="product-name" @bind-Item="@VM.Product.Description" Label="Description" PlaceHolder="e.g. Short description." />
                        <TextComponent Id="category-name" @bind-Item="@VM.Category.Name" Label="Category" PlaceHolder="e.g. Drinks" />
                        <DoubleComponent Id="price" @bind-Item="@VM.Product.Price" Label="Price" Prefix="@VM.AppSetting.Currency" PlaceHolder="0.00" />
                    </div>
                </div>
            </div>

            <div class="flex gap-4 mt-8">
                <button @onclick="@(() => NextAsync(step: "2"))" class="px-6 py-4 rounded-2xl font-bold text-on-surface-variant bg-surface-container-highest hover:bg-outline-variant/20 transition-all">
                    Back
                </button>
                <button id="btn-next-2" disabled="@(!@VM.Product.ValidContent())" @onclick="@(() => NextAsync(step: "4"))" class="flex-1 ledger-gradient text-white py-4 rounded-2xl font-bold shadow-xl active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    Save & Continue
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </div>
        </div>

        <!-- Step 4: Finish -->
        <div id="step-4" class="space-y-6 text-center hidden">
            <div class="w-24 h-24 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6 animate-pop scale-0">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path class="animate-check" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
            </div>

            <h3 class="text-2xl font-bold font-headline text-on-surface">Setup Complete!</h3>
            <p class="text-on-surface-variant max-w-md mx-auto">
                <strong id="finalStoreName" class="text-primary">@VM.AppSetting.StoreName</strong> is ready to go. You can always add more products and details from the dashboard or settings.
            </p>

            <a href="javascript:void(0)" @onclick="@VM.LoginAndNavigateToHome" class="block w-full mt-8 ledger-gradient text-white py-4 rounded-2xl font-bold shadow-xl active:scale-[0.98] transition-all">
                Launch JPay
            </a>
        </div>

    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAppSetting();
        await base.OnInitializedAsync();
    }

    public async Task NextAsync(string step)
    {
        if (step == "1") await VM.LoadInitialUser();
        if (step == "2")
        {
            await VM.LoadInitialUser();
            await VM.SaveAppSettings();
        }
        if (step == "3") await VM.SaveOwnerDetails();
        if (step == "4") {
            await VM.SaveProductAsync();    
        }
        await JS.InvokeVoidAsync("goToStep", $"{step}");
    }

    public async Task UploadImageAsync()
    {
        VM.IsProcessing = true;
        var output = await ImageService.PickAndResizeAsync(500);
        VM.Product.TempImageUrl = output.tempPath;
        VM.Product.ImageUrl = output.photoPath;
        VM.IsProcessing = false;
    }
}


