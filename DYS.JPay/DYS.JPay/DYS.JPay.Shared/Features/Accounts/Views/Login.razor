@page "/login"
@layout EmptyLayout
@using DYS.JPay.Shared.Features.Accounts.ViewModels
@using DYS.JPay.Shared.Shared.Services
@using Microsoft.AspNetCore.Authorization
@inject LoginViewModel VM



    <div id="main" class="h-full p-4 bg-primary-subtle mx-auto my-auto">
    <div class="w-full max-w-md">
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 animate-fade-in-up">
            <div class="text-center mb-8">
                <h1 class="text-5xl font-black font-headline text-primary tracking-tight">JPay</h1>
                <p class="text-sm text-gray-500 font-medium mt-1">Point of Sale System</p>
            </div>

            <form class="space-y-4">
                <div class="space-y-1.5">
                    <TextComponent Id="username" @bind-Item="@VM.Profile.Username" Label="Username" PlaceHolder="e.g. admin" />
                </div>
                <div class="space-y-1.5">
                    <PasscodeComponent Id="passcode" @bind-Item="@VM.Profile.Passcode" Label="6-Digit Code" PlaceHolder="••••••" />
                </div>
                 <div class="space-y-1.5">
                    <ButtonComponent Disabled="@(!VM.Profile.ValidContent())" Id="btn-login" IsBusy="@VM.IsBusy" Click="@VM.BasicLogin" ActionText="Sign in" Style="bg-primary text-white w-full" />
                </div>
            </form>

          <NotificationComponent Notification="@VM.Notification"/>
        </div>

    </div>
</div>

@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

}

