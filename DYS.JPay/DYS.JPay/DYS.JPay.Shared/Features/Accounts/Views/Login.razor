@page "/login"
@layout EmptyLayout
@using DYS.JPay.Shared.Features.Accounts.ViewModels
@using DYS.JPay.Shared.Shared.Services
@using Microsoft.AspNetCore.Authorization
@inject LoginViewModel LoginVM



    <div id="main" class="h-full p-4 bg-primary-subtle mx-auto my-auto">
    <div class="w-full max-w-md">
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 animate-fade-in-up">
            <div class="text-center mb-8">
                <h1 class="text-5xl font-black font-headline text-primary tracking-tight">JPay</h1>
                <p class="text-sm text-gray-500 font-medium mt-1">Point of Sale System</p>
            </div>

            <form class="space-y-4">
                <div class="space-y-1.5">
                    <TextComponent Id="username" @bind-Item="@LoginVM.Profile.Username" Label="Username" PlaceHolder="e.g. admin" />
                </div>
                <div class="space-y-1.5">
                    <PasscodeComponent Id="passcode" @bind-Item="@LoginVM.Profile.Passcode" Label="6-Digit Code" PlaceHolder="••••••" />
                </div>
                <button type="button" @onclick="@LoginVM.BasicLogin" class="w-full active:scale-95 bg-primary hover:bg-primary/90 text-white font-bold py-3 rounded-xl transition-colors shadow-md mt-2">Sign In</button>
            </form>

          <NotificationComponent Notification="@LoginVM.Notification"/>
        </div>

    </div>
</div>

@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

}

