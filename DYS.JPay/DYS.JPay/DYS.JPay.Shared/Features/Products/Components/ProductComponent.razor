@using DYS.JPay.Shared.Shared.Entities
@inject IJSRuntime JS
@inject IPhotoService PhotoService

<div class="flex items-center justify-between p-6 border-b border-outline-variant/10 bg-surface-container-low/30">
    <div>
        <h2 id="offcanvas-title" class="text-2xl font-headline font-extrabold text-primary">
            @BooleanExtensions.GetConditionalString(Product.Id.HasValue,"Edit product","New product")
        </h2>
        <p id="offcanvas-subtitle" class="text-sm text-on-surface-variant mt-1">
            @BooleanExtensions.GetConditionalString(Product.Id.HasValue, "Edit existing product.", "Create new product listing.")
        </p>
    </div>
    <button @onclick="@OnCancelAsync" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors text-on-surface-variant">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
</div>

<div class="flex-1 overflow-y-auto display-6 pr-6 pl-6 no-scrollbar">
    <form id="canvass-form" class="space-y-2">
        <div class="space-y-1">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
                <!-- Image button -->
                <button type="button" @onclick="@ImageUploaded" class="bg-surface-container-lowest rounded-2xl p-2 border border-outline-variant/10 shadow-sm hover:shadow-md hover:border-primary/30 transition-all text-left flex flex-col h-full group w-full md:w-1/3">
                    <div class="overflow-hidden w-full aspect-square bg-surface-container-low rounded-xl mb-0 relative group-hover:scale-105 transition-transform duration-300">
                        @if (IsProcessing)
                        {
                            <div class="w-24 h-24 flex items-center justify-center mx-auto mb-6">
                                <svg class="animate-spin w-12 h-12 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                    <!-- Outer ring -->
                                    <circle class="opacity-25" cx="12" cy="12" r="10"
                                            stroke="currentColor" stroke-width="4" fill="none"></circle>
                                    <!-- Arc segment -->
                                    <path class="opacity-75" fill="currentColor"
                                          d="M12 2a10 10 0 0 1 10 10h-4a6 6 0 0 0-6-6V2z"></path>
                                </svg>
                            </div>

                        }
                        else
                        {

                            @if (!string.IsNullOrEmpty(ImagePath))
                            {
                                <img src="@ImagePath" alt="" class="rounded-xl w-full h-full object-cover" referrerpolicy="no-referrer">
                            }
                            else
                            {
                                <div class="p-5">
                                    <svg class="w-50 h-50" fill="none" stroke="gray" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                </div>
                            }
                        }
                    </div>
                </button>
                <!-- Image button -->

                <!-- Form fields -->
                <div class="w-full md:w-2/3">
                    <div class="space-y-1">
                        <TextComponent Id="name" @bind-Item="@Product.Name" Label="Product Name" PlaceHolder="e.g. add name" />
                    </div>
                    <div class="space-y-1">
                        <TextComponent Id="code" @bind-Item="@Product.Code" Label="Code" PlaceHolder="e.g. UODFXDFEe" />
                    </div>
                </div>
            </div>
        </div>

       

        <div class="space-y-1">
            <label class="text-xs text-on-surface-variant uppercase tracking-wider pl-1">Category</label>
            <select @bind="Product.CategoryId"
                    class="w-full bg-surface-container-low border-none rounded-2xl px-5 py-2 text-sm focus:ring-2 focus:ring-primary transition-all">
                @foreach (var category in Categories!)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>

        <div class="space-y-1">
            <DoubleComponent Id="price" @bind-Item="@Product.Price" Label="Price" Prefix="@Currency" PlaceHolder="0.00" />
        </div>
        <div class="space-y-1">
            <TextAreaComponent Id="description" @bind-Item="@Product.Description" Label="Description" PlaceHolder="e.g. add short description" />
        </div>
        <div class="space-y-1">
            <CheckboxComponent Visible="true" @bind-Item="@Product.Active" Label="Product status" SubLabel="Set if active or inactive." />
        </div>
        <div class="space-y-1">
            <CheckboxComponent Visible="@(Product.Id != null)" ItemTriggered="@ConfirmDeletionAsync" @bind-Item="@Product.IsDeleted" Label="Soft delete" SubLabel="Soft delete product." />
        </div>
         
    </form>
</div>

<div class="p-6 border-t border-outline-variant/10 bg-surface-container-lowest flex gap-3 mb-5">
    <ButtonComponent  Id="btn-cancel" Click="@OnCancelAsync" ActionText="Cancel" Style="bg-surface-container-highest text-on-surface border-t border-outline-variant/10" />
    <ButtonComponent Disabled="@(!Product.ValidContent())" Id="btn-product" IsBusy="@IsBusy" Click="@OnSaveAsync" ActionText="@ActionText" Style="@ActionStyle" />
</div>

@code {
    [Parameter]
    public string Currency { get; set; } = string.Empty;
    [Parameter]
    public string ActionText { get; set; } = "Save product";
    [Parameter]
    public string ActionStyle { get; set; } = "bg-primary text-white";
    [Parameter]
    public bool IsBusy { get; set; } = false;
    [Parameter]
    public bool IsProcessing { get; set; } = false;
    [Parameter]
    public ProductDto Product { get; set; } = new ProductDto();
    [Parameter]
    public List<CategoryDto> Categories { get; set; } = new List<CategoryDto>();
    [Parameter]
    public EventCallback<ProductDto> ProductChanged { get; set; } 
    [Parameter]
    public EventCallback ImageUploaded { get; set; }
    [Parameter]
    public EventCallback Save { get; set; }
    public string ImagePath { get; set; } = string.Empty;



    public async Task OnSaveAsync()
    {
        await ProductChanged.InvokeAsync(Product);
        await Save.InvokeAsync();
        await JS.InvokeVoidAsync("trigger", "btn-search");
        await Initialize();
    }

    public async Task OnCancelAsync()
    {
        await JS.InvokeVoidAsync("closeOffcanvas", "product-overlay", "product-component");
        await JS.InvokeVoidAsync("trigger", "btn-search");
        await Initialize();
    }

    public async Task Initialize()
    {
        ActionText = "Save product";
        ActionStyle = "bg-primary text-white";
    }

    public async Task ConfirmDeletionAsync(bool delete)
    {
        if (delete) {
            ActionText = "Confirm deletion";
            ActionStyle = "bg-red-500 text-white";
        }
        else await Initialize();
    }

    public async Task LoadImageAsync()
    {
        if (Product?.ImageUrl?.Contains("https") == true) ImagePath = Product.ImageUrl;
        else
        {
            if (!string.IsNullOrEmpty(Product?.ImageUrl))
                ImagePath = await PhotoService.GetImageDataUriAsync(Product.TempImageUrl, Product.ImageUrl);
            else ImagePath = string.Empty;
        }
    }
}
