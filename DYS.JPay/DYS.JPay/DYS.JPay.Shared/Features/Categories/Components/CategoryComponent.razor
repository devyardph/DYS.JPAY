@using DYS.JPay.Shared.Shared.Entities
@inject IJSRuntime JS

<div class="flex items-center justify-between p-6 border-b border-outline-variant/10 bg-surface-container-low/30">
    <div>
        <h2 id="offcanvas-title" class="text-2xl font-headline font-extrabold text-primary">
            @BooleanExtensions.GetConditionalString(Category.Id.HasValue, "Edit category", "New category")
        </h2>
        <p id="offcanvas-subtitle" class="text-sm text-on-surface-variant mt-1">
            @BooleanExtensions.GetConditionalString(Category.Id.HasValue, "Edit existing category.", "Create new category listing.")
        </p>
    </div>
    <button @onclick="@OnCancelAsync" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors text-on-surface-variant">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
</div>

<div class="flex-1 overflow-y-auto p-6 no-scrollbar">
    <form id="canvass-form" class="space-y-3">
        <div class="space-y-1.5">
            <TextComponent Id="name" @bind-Item="@Category.Name" Label="Category Name" PlaceHolder="e.g. add name" />
        </div>
        <div class="space-y-1.5">
            <TextAreaComponent Id="description" @bind-Item="@Category.Description" Label="Description" PlaceHolder="e.g. add name" />
        </div>
        <div class="space-y-2">
            <CheckboxComponent Visible="true" @bind-Item="@Category.Active" Label="Category status" SubLabel="Set if active or inactive." />
        </div>
        <div class="space-y-2">
            <CheckboxComponent Visible="@(Category.Id != null)" ItemTriggered="@ConfirmDeletionAsync" @bind-Item="@Category.IsDeleted" Label="Soft delete" SubLabel="Soft delete category." />
        </div>
    </form>
</div>

<div class="p-6 border-t border-outline-variant/10 bg-surface-container-lowest flex gap-3 mb-5">
    <ButtonComponent Id="btn-cancel" Click="@OnCancelAsync" ActionText="Cancel" Style="bg-surface-container-highest text-on-surface border-t border-outline-variant/10" />
    <ButtonComponent Id="btn-category" IsBusy="@IsBusy" Click="@OnSaveAsync" ActionText="@ActionText" Style="@ActionStyle" />
</div>

@code {
    [Parameter]
    public string ActionText { get; set; } = "Save category";
    [Parameter]
    public string ActionStyle { get; set; } = "bg-primary text-white";
    [Parameter]
    public bool IsBusy { get; set; }
    [Parameter]
    public CategoryDto Category { get; set; } = new CategoryDto();
    [Parameter]
    public EventCallback<CategoryDto> CategoryChanged { get; set; }
    [Parameter]
    public EventCallback Save { get; set; }


    public async Task OnSaveAsync()
    {
        await CategoryChanged.InvokeAsync(Category);
        await Save.InvokeAsync();
        await JS.InvokeVoidAsync("trigger", "btn-search");
        Initialize();
    }

    public async Task OnCancelAsync()
    {
        await JS.InvokeVoidAsync("closeOffcanvas", "category-overlay", "category-component");
        await JS.InvokeVoidAsync("trigger", "btn-search");
        Initialize();
    }

    public async Task ConfirmDeletionAsync(bool delete)
    {
        if (delete) {
            ActionText = "Confirm deletion";
            ActionStyle = "bg-red-500 text-white";
        }
        else Initialize();
    }

    public void Initialize()
    {
        ActionText = "Save category";
        ActionStyle = "bg-primary text-white";
    }
}
