@using DYS.JPay.Shared.Shared.Entities

<div class="flex items-center justify-between p-6 border-b border-outline-variant/10 bg-surface-container-low/30">
    <div>
        <h2 id="offcanvas-title" class="text-2xl font-headline font-extrabold text-primary">
            @Promotion.Name
        </h2>
        <small>Promo runs from @Promotion.StartDate.ToLocalTime().FormatDate("dd MMM yyyy") to @Promotion.EndDate.ToLocalTime().FormatDate("dd MMM yyyy")</small>
    </div>
   
</div>

<div class="flex-1 overflow-y-auto p-6 no-scrollbar">
    <form id="canvass-form" onsubmit="event.preventDefault(); closeOffcanvas();" class="space-y-3">
        @if (PromotionItems.Where(query => query.IsDeleted !=true).Any())
        {
            @foreach (var item in PromotionItems.Where(query => query.IsDeleted != true)!)
            {
                <div class="flex space-x-4">
                    <!-- Product Name -->
                    <div class="flex-1">
                    <div class="flex items-center gap-3">
                        <div>
                            <p class="text-sm font-bold text-gray-900"> @item.ProductName</p>
                            <p class="text-xs text-gray-500">@Currency @item.ActualPrice</p>
                        </div>
                    </div>
                    </div>
                    <!-- Price -->
                    <div class="w-40">
                      
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 font-bold text-primary">@Currency</span>
                            <input @bind-value="@item.DiscountedPrice"
                            type="number"
                            step="0.01"
                            required
                            placeholder="0.00"
                            class="w-full pl-10 pr-5 py-2 bg-surface-container-low border-none rounded-2xl text-sm focus:ring-2 focus:ring-primary transition-all outline-none" />
                        </div>
                    </div>
                </div>
            }
        }
        <div class="space-y-1.5">
            <AlertComponent Notification="@Notification" />
        </div>
    </form>
</div>

<div class="p-6 border-t border-outline-variant/10 bg-surface-container-lowest flex gap-3 mb-5">
    <button onclick="closeOffcanvas('pricing-overlay','pricing-component')" class="flex-1 py-2 bg-surface-container-highest text-on-surface rounded-2xl font-bold hover:bg-outline-variant/30 transition-colors">
        Cancel
    </button>
    <button @onclick="@OnSave" id="offcanvas-submit" type="submit" form="user-form" class="flex-1 py-2 bg-primary text-white rounded-2xl font-bold shadow-xl active:scale-95 transition-all">
        Save discounts
    </button>
</div>

@code {
    [Parameter]
    public string Currency { get; set; } = string.Empty;
    [Parameter]
    public string ActionText { get; set; } = string.Empty;
    [Parameter]
    public bool IsBusy { get; set; }
    [Parameter]
    public PromotionDto Promotion { get; set; } = new PromotionDto();
    [Parameter]
    public NotificationDto Notification { get; set; } = new NotificationDto();
    [Parameter]
    public List<PromotionItemDto> PromotionItems { get; set; } = new List<PromotionItemDto>();
    [Parameter]
    public EventCallback<List<PromotionItemDto>> PromotionItemsChanged { get; set; }
    [Parameter]
    public EventCallback Save { get; set; }

    public void OnSave()
    {
        PromotionItemsChanged.InvokeAsync(PromotionItems);
        Save.InvokeAsync();
    }

    public void InitializeContents(ProductDto product, List<VariantDto> variants)
    {
        StateHasChanged();
    }
}
