@using DYS.JPay.Shared.Shared.Settings
@inject IJSRuntime JS

<div id="discount-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 ease-in-out">
    <div class="bg-surface-container-lowest rounded-3xl p-8 max-w-lg w-full shadow-2xl transform scale-95 transition-transform duration-300" id="discount-modal-content">
        <!-- Payment Info -->
        <div class="mb-6">
            <div class="flex items-center justify-center relative mb-1">
                <!-- Left button -->
                <div class="absolute left-0">
                
                </div>

                <!-- Centered amount -->
                <div class="text-center mb-3 p-2 rounded-xl">
                    <h2 class="text-5xl font-headline font-bold text-primary mb-2">
                        @Currency@Transaction?.Total?.ToString("N2")
                    </h2>
                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">
                        TOTAL AMOUNT
                    </label>
                </div>

                <!-- Right placeholder (optional) -->
                <div class="absolute right-0">
                    <button @onclick="@ClosePayment" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24" height="24" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-x w-5 h-5"
                             aria-hidden="true">
                            <path d="M18 6L6 18"></path>
                            <path d="M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="space-y-2">
                <div class="flex justify-between gap-3">
                    <div class="space-y-2">
                        <DoubleComponent Style="py-4 bg-[#f1f4fa]" ItemTriggered="@OnAmountInPercentageChanged" Id="percentage-discount" @bind-Item="@DiscountInPercentage" Label="Percentage Discount" Prefix="%" PlaceHolder="0.00" />
                    </div>
                    <div class="space-y-2 text-right">
                        <DoubleComponent Style="py-4 bg-[#f1f4fa]" ItemTriggered="@OnDiscountAmountChanged" Id="change" @bind-Item="@DiscountAmount" Label="Discount in Amount" Prefix="@Currency" PlaceHolder="0.00" />
                    </div>
                </div>
            </div>

        </div>

        <!-- Confirm Button -->
        <div class="flex items-center gap-3 mb-0">
            <button @onclick="@(() => SetDiscountAsync())" class="w-full text-uppercase bg-primary text-white py-4 rounded-xl  shadow-lg active:scale-95 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
               SET DISCOUNT
            </button>
        </div>
      
    </div>
</div>

@code {
    [Parameter]
    public string Currency { get; set; } = string.Empty;
    [Parameter]
    public double? DiscountInPercentage { get; set; } 
    [Parameter]
    public double? DiscountAmount { get; set; }
    [Parameter]
    public TransactionDto Transaction { get; set; } = new TransactionDto();
    [Parameter]
    public EventCallback<TransactionDto> TransactionChanged { get; set; }
    [Parameter]
    public EventCallback DiscountChanged { get; set; }
    [Parameter]
    public double? Change { get; set; }


    public async Task ClosePayment()
    {
        await JS.InvokeVoidAsync("closeModal", "discount-modal");
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) StateHasChanged();
        return base.OnAfterRenderAsync(firstRender);
    }

    private void OnAmountInPercentageChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var amount))
        {
            DiscountInPercentage = amount;
            var discountAmount = Transaction.Total * (DiscountInPercentage/100);
            DiscountAmount = Math.Round(discountAmount ?? 0, 2);
            StateHasChanged();
        }
        else
        {
            DiscountAmount = null;
            DiscountInPercentage = null;
        }
    }

    private void OnDiscountAmountChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var amount))
        {
            DiscountAmount = amount;
            var percentage = (DiscountAmount / Transaction.Total) * 100;
            DiscountInPercentage = Math.Round(percentage ?? 0, 2);
            StateHasChanged();
        }
        else
        {
            DiscountAmount = null;
            DiscountInPercentage = null;
        }
    }

    private async Task SetDiscountAsync()
    {
        Transaction.DiscountAmount = DiscountAmount;
        Transaction.DiscountInPercentage = DiscountInPercentage;
        await JS.InvokeVoidAsync("closeModal", "discount-modal");
        await TransactionChanged.InvokeAsync(Transaction);
        await DiscountChanged.InvokeAsync();
    }
}
