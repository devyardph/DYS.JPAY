@using DYS.JPay.Shared.Shared.Settings
@inject IJSRuntime JS

<div id="charge-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300 ease-in-out">
    <div class="bg-surface-container-lowest rounded-3xl p-8 max-w-lg w-full shadow-2xl transform scale-95 transition-transform duration-300" id="charge-modal-content">
        <!-- Payment Info -->
        <div class="mb-6">
            <div class="flex items-center justify-center relative mb-1">
                <!-- Left button -->
                <div class="absolute left-0">
                    <button @onclick="@BackToPayment" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24" height="24" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-arrow-right w-5 h-5 rotate-180"
                             aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg>
                    </button>
                </div>

                <!-- Centered amount -->
                <div class="text-center mb-3 p-2 rounded-xl">
                    <h2 class="text-5xl font-headline font-bold text-primary mb-2">
                        @Currency@Transaction?.GrandTotal?.ToString("N2")
                    </h2>
                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">
                        @Transaction?.PaymentMode PAYMENT
                    </label>
                </div>

                <!-- Right placeholder (optional) -->
                <div class="absolute right-0">
                    <button @onclick="@ClosePayment" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="24" height="24" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"
                             class="lucide lucide-x w-5 h-5"
                             aria-hidden="true">
                            <path d="M18 6L6 18"></path>
                            <path d="M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="space-y-2">
                @if (Transaction?.PaymentMode == GlobalSettings.CASH) {
                <div class="flex justify-between gap-3">
                    <div class="space-y-2">
                        <DoubleComponent Style="py-4 bg-[#f1f4fa]" ItemTriggered="@OnAmountTenderChanged" Id="amount-tendered" @bind-Item="@Transaction?.AmountTendered" Label="Amount tender" Prefix="@Currency" PlaceHolder="0.00" />
                    </div>
                    <div class="space-y-2 text-right">
                        <DoubleComponent Style="py-4 bg-[#f1f4fa]" Id="change" @bind-Item="@Change" Label="Change" Prefix="@Currency" PlaceHolder="0.00" />
                    </div>
                </div>
                }
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Customer Name</label>
                    <input type="text" @bind-value="@Transaction!.CustomerName" placeholder="eg. Name" class="w-full bg-[#f1f4fa] border-none rounded-2xl px-6 py-4 text-base font-headline font-bold focus:ring-2 focus:ring-[#003345] transition-all">
                </div>
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Reference no.</label>
                    <input type="text" @bind-value="@Transaction!.ReferenceNo" placeholder="e.g. 23423" class="w-full bg-[#f1f4fa] border-none rounded-2xl px-6 py-4 text-base font-headline font-bold focus:ring-2 focus:ring-[#003345] transition-all">
                </div>
            </div>

        </div>

        <!-- Confirm Button -->
        <div class="flex items-center gap-3 mb-0">
            <button disabled="@(!Transaction.ValidContent())" @onclick="@(() => OnProcessPayment())" class="w-full text-uppercase bg-primary text-white py-4 rounded-xl  shadow-lg active:scale-95 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
               CONFIRM PAYMENT
            </button>
        </div>
      
    </div>
</div>

@code {
    [Parameter]
    public string Currency { get; set; } = string.Empty;
    [Parameter]
    public TransactionDto Transaction { get; set; } = new TransactionDto();
    [Parameter]
    public EventCallback<TransactionDto> TransactionChanged { get; set; }
    [Parameter]
    public EventCallback ProcessPayment { get; set; }
    [Parameter]
    public double? Change { get; set; }

    public async Task OnProcessPayment() => await ProcessPayment.InvokeAsync();

    public async Task BackToPayment()
    {
        await JS.InvokeVoidAsync("closeModal", "charge-modal");
        await JS.InvokeVoidAsync("openModal", "payment-modal");
    }

    public async Task ClosePayment()
    {
        await JS.InvokeVoidAsync("closeModal", "charge-modal");
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) StateHasChanged();
        return base.OnAfterRenderAsync(firstRender);
    }

    private void OnAmountTenderChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var amount))
        {
            Transaction.AmountTendered = amount;
            var change = Transaction.AmountTendered - Transaction.GrandTotal;
            Change = Math.Round(change ?? 0, 2);
            StateHasChanged();
        }
    }
}
