@page "/"
@using DYS.JPay.Shared.Features.Products.ViewModels
@using DYS.JPay.Shared.Features.Sale.Components
@inject IJSRuntime JS
@using DYS.JPay.Shared.Shared.Helpers
@inject IFileService ImageService
@inject SaleViewModel VM

<PageComponent>
    <PageContent>
        <!-- Main Content -->
        <div id="main-content" class="flex-1 lg:ml-64 h-screen overflow-y-auto lg:overflow-hidden flex flex-col lg:flex-row transition-all duration-300">
            <main class="flex-1 p-4 md:p-8 lg:pr-[26rem] opacity-0 animate-fade-in-up lg:overflow-y-auto no-scrollbar">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">

                    <!--HEADER-->
                    <div class="flex items-center gap-4">
                        <button onclick="toggleMobileMenu()" class="lg:hidden p-2 text-on-surface-variant hover:bg-surface-container-highest rounded-full transition-colors -ml-2">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                        </button>
                        <div>
                            <h1 class="text-3xl font-headline font-bold text-primary">@VM.Session.AppSettings.StoreName</h1>
                            <p class="text-on-surface-variant">@VM.Session.AppSettings.StoreDescription / @VM.Promotion?.Name</p>
                        </div>
                    </div>
                    <!--HEADER-->

                    <!--SEARCH-->
                    <div class="flex items-center gap-4 w-full sm:w-auto mt-4 sm:mt-0">
                        <div class="relative flex-1 sm:w-64">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            <input id="search-input" @oninput="@VM.SearchProducts" @bind-value="@VM.Search.Keyword" type="text" placeholder="Search products..." class="w-full pl-10 pr-4 py-4 bg-surface-container-lowest border border-outline-variant/20 rounded-xl text-sm focus:ring-1 focus:ring-primary transition-all" />
                        </div>
                        <div class="flex items-center bg-surface-container-lowest rounded-lg p-2 shrink-0 border border-outline-variant/20">

                            <button @onclick="@(() => @VM.OnDisplayChanged("grid"))" id="view-grid-btn" class="p-2 rounded-md transition-colors hover:text-primary @BooleanExtensions.GetConditionalString(@VM.Session.AppSettings.Display == "grid", "bg-surface-container-highest text-primary shadow-sm", "text-on-surface-variant")">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            </button>
                            <button @onclick="@(() => @VM.OnDisplayChanged("list"))" id="view-list-btn" class="p-2 rounded-md transition-colors hover:text-primary @BooleanExtensions.GetConditionalString(@VM.Session.AppSettings.Display == "list", "bg-surface-container-highest text-primary shadow-sm", "text-on-surface-variant")">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                            </button>
                        </div>

                    </div>
                    <!--SEARCH-->

                </div>

                <!-- CATEGORIES -->
                <div id="categories-container" class="flex gap-2 overflow-x-auto no-scrollbar pb-4 mb-4">
                    <button @onclick="@(() => @VM.SelectCategory(new SelectDto() { Id = "" }))" class="px-4 py-2 rounded-xl text-sm whitespace-nowrap transition-all @BooleanExtensions.GetConditionalString(VM.Category.Id == "", "bg-primary text-white shadow-md", "bg-surface-container-lowest text-on-surface-variant hover:bg-surface-container-highest border border-outline-variant/10")">All items</button>
                    @foreach (var category in VM.Categories)
                    {
                        <button @onclick="@(() => @VM.SelectCategory(category))" class="px-4 py-2 rounded-xl text-sm whitespace-nowrap transition-all @BooleanExtensions.GetConditionalString(VM.Category.Id == category.Id, "bg-primary text-white shadow-md", "bg-surface-container-lowest text-on-surface-variant hover:bg-surface-container-highest border border-outline-variant/10")">@category.Name</button>
                    }
                </div>
                <!-- CATEGORIES -->

                <!-- PRODUCTS -->
                <ProductsComponent Display="@VM.Session.AppSettings.Display"
                                   Products="@VM.MenuProducts"
                                   AddToOrder="VM.AddOrderAsync"
                                   Currency="@VM.Session.AppSettings.Currency" />
                <!-- PRODUCTS -->
            </main>

            <!-- CART -->
            <CartComponent OrderItems="@VM.Orders" Staff="@VM.Session.CurrentUser.Name" OrderChanged="@VM.OrderChanged" Currency="@VM.Session.AppSettings.Currency" Transaction="@VM.Transaction" />
            <!-- CART -->
        </div>

        <PaymentComponent @bind-Transaction="@VM.Transaction" Currency="@VM.Session.AppSettings.Currency" />
        <ChargeComponent @bind-Transaction="@VM.Transaction" ProcessPayment="@VM.ProcessPaymentAsync" Currency="@VM.Session.AppSettings.Currency" />
        <ResultComponent @bind-Transaction="@VM.Transaction" @bind-Orders="@VM.Orders" />
        <VariantsComponent Variants="@VM.Variants" Product="@VM.Product" Currency="@VM.Session.AppSettings.Currency" AddToOrder="VM.AddOrderAsync" />
        <DiscountComponent @bind-Transaction="@VM.Transaction" DiscountChanged="@VM.TransactionChanged" Currency="@VM.Session.AppSettings.Currency" />
        <!-- Mobile Floating Cart Button -->
        <button id="mobile-cart-btn" onclick="toggleMobileCart()" class="lg:hidden fixed bottom-6 right-6 z-40 bg-primary text-white p-4 rounded-full shadow-2xl flex items-center justify-center hover:scale-105 active:scale-95 transition-all">
            <div class="relative">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                <span id="mobile-cart-badge" class="absolute -top-2 -right-2 bg-error text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center border-2 border-surface-container-lowest hidden">@VM.Transaction.Count</span>
            </div>
        </button>
        <!-- Overlay for Mobile Cart -->
        <div id="mobile-cart-overlay" onclick="toggleMobileCart()" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden opacity-0 transition-opacity duration-300 lg:hidden"></div>
    </PageContent>
</PageComponent>


@code {
    @code {
        protected override async Task OnInitializedAsync()
        {
            await VM.InitiazeCategoriesAndProductsAsync();
            await base.OnInitializedAsync();
            StateHasChanged();
        }

        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (!string.IsNullOrEmpty(VM.PendingCartId))
            {
                await JS.InvokeVoidAsync("animateCart", VM.PendingCartId);
                VM.PendingCartId = string.Empty;
            }
        }

        public async Task ProcessOrderAsync() => await JS.InvokeVoidAsync("openModal", "payment-modal");
    }

}