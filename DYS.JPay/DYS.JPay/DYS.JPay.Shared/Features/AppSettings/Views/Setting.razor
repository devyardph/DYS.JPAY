@page "/settings"
@using DYS.JPay.Shared.Features.AppSettings.Components
@using DYS.JPay.Shared.Features.Orders.ViewModels
@using DYS.JPay.Shared.Shared.Components
@using DYS.JPay.Shared.Shared.Extensions
@using DYS.JPay.Shared.Shared.Settings
@using Microsoft.AspNetCore.Authorization
@inject AppSettingsViewModel VM

 
<PageComponent>
    <PageContent>
        <div id="main-content" class="flex-1 lg:ml-64 min-h-screen flex flex-col transition-all duration-300">
            <main class="flex-1 pt-10 px-4 md:px-8 lg:px-12 pb-16 max-w-7xl mx-auto w-full opacity-0 animate-fade-in-up space-y-6">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-3">
                    <div>
                        <h1 class="text-3xl font-headline font-extrabold text-primary tracking-tight">General settings</h1>
                        <p class="text-sm text-on-surface-variant">Store settings configuration.</p>
                    </div>
                    <ContentComponent Roles="@($"{GlobalSettings.ADMIN},{GlobalSettings.OWNER}")">
                        <Content>
                            <div class="flex gap-3">
                                <a href="javascript:void(0)" @onclick="@(() => VM.OpenSetting(VM.Session.AppSettings))" class="px-4 py-2 bg-primary text-white rounded-2xl shadow-lg active:scale-95 transition-all flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                                    <span>Change setting</span>
                                </a>
                            </div>
                        </Content>
                    </ContentComponent>
                </div>

                <div class="p-10 bg-surface-container-lowest rounded-2xl border border-outline-variant/10 shadow-sm overflow-hidden">
                    <div class="space-y-4">
                        <div class="space-y-2">
                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                                <div class="bg-white p-3 space-y-3">
                                    <div class="flex-1">
                                        <div class="flex-1 mb-5">
                                            <h1 class="text-2xl font-headline font-extrabold text-gray tracking-tight">Store settings</h1>
                                            <p class="text-sm text-on-surface-variant">Store settings configuration.</p>
                                        </div>
                                        <div class="space-y-2 mb-2">
                                            <LabelComponent Id="store-name" Item="@VM.AppSetting.StoreName" Label="Store Name"  Style="bg-[#f1f4fa] rounded-2xl" />
                                        </div>
                                        <div class="space-y-2  mb-2">
                                            <LabelComponent Id="store-description" Item="@VM.AppSetting.StoreDescription" Label="Store Description" Style="bg-[#f1f4fa] rounded-2xl" />
                                        </div>
                                         <div class="space-y-2  mb-2">
                                            <LabelComponent Id="store-branch" Item="@VM.AppSetting.Branch" Label="Store Branch" Style="bg-[#f1f4fa] rounded-2xl" />
                                        </div>
                                        <div class="space-y-2  mb-2">
                                            <LabelComponent Id="store-counter" Item="@VM.AppSetting.Counter" Label="Counter no." Style="bg-[#f1f4fa] rounded-2xl" />
                                        </div>

                                        <div class="space-y-2  mb-2">
                                            <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Product display settings</label>
                                            <div class="flex gap-2">
                                                <button class="p-3 rounded-xl shadow-lg scale-110 @BooleanExtensions.GetConditionalString(VM.AppSetting.Display == "grid", "bg-primary text-white", "bg-[#f1f4fa] text-[#40484c] hover:bg-[#dfe3e8]")">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         width="24" height="24"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round"
                                                         class="lucide lucide-layout-grid w-5 h-5"
                                                         aria-hidden="true">
                                                        <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                                                        <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                                                        <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                                                        <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                                                    </svg>
                                                </button>
                                                <button class="p-3 rounded-xl @BooleanExtensions.GetConditionalString(VM.AppSetting.Display == "list", "bg-primary text-white", "bg-[#f1f4fa] text-[#40484c] hover:bg-[#dfe3e8]")">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         width="24" height="24"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round"
                                                         class="lucide lucide-list w-5 h-5"
                                                         aria-hidden="true">
                                                        <path d="M3 5h.01"></path>
                                                        <path d="M3 12h.01"></path>
                                                        <path d="M3 19h.01"></path>
                                                        <path d="M8 5h13"></path>
                                                        <path d="M8 12h13"></path>
                                                        <path d="M8 19h13"></path>
                                                    </svg>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="space-y-2  mb-2">
                                            <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Currency</label>
                                            <select @bind="@VM.AppSetting.Currency" disabled
                                                    class="w-full bg-[#f1f4fa] border-none rounded-2xl px-5 py-3 text-sm focus:ring-2 focus:ring-primary transition-all">
                                                @foreach (var currency in GlobalSettings.Currencies!)
                                                {
                                                    <option value="@currency.DisplayName">@currency.Name - @currency.DisplayName</option>
                                                }
                                            </select>
                                        </div>
                                      @*   <div class="space-y-2  mb-2">
                                            <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Time zone</label>
                                            <select @bind="@VM.AppSetting.TimeZone" disabled
                                                    class="w-full bg-[#f1f4fa] border-none rounded-2xl px-5 py-3 text-sm focus:ring-2 focus:ring-primary transition-all">
                                                @foreach (var zone in VM.TimeZones!)
                                                {
                                                    <option value="@zone.Id">@zone.Name</option>
                                                }
                                            </select>
                                        </div> *@
                                        <div class="space-y-2 mb-5">
                                            <LabelComponent Id="tax" Item="@($"{VM.AppSetting.Tax?.ToString()}%")" Label="Tax" Style="bg-[#f1f4fa] rounded-2xl" />
                                        </div>
                                        <div class="flex-1 mb-5">
                                            <h1 class="text-2xl font-headline font-extrabold text-gray tracking-tight">Sales Target in @VM.AppSetting.Currency</h1>
                                            <p class="text-sm text-on-surface-variant">Setup daily, weekly, monthly and yearly targets.</p>
                                        </div>
                                        <div class="space-y-2">
                                            <div class="flex gap-4">
                                                <div class="flex-1">
                                                    <LabelComponent Id="daily" Item="@(VM.AppSetting.TargetDailySales?.ToString("N0"))" Label="Daily" Style="bg-[#f1f4fa] rounded-2xl" />
                                                </div>
                                                <div class="flex-1">
                                                    <LabelComponent Id="weekly" Item="@(VM.AppSetting.TargetWeeklySales?.ToString("N0"))" Label="weekly" Style="bg-[#f1f4fa] rounded-2xl" />
                                                </div>
                                                <div class="flex-1">
                                                    <LabelComponent Id="monthly" Item="@(VM.AppSetting.TargetMonthlySales?.ToString("N0"))" Label="monthly" Style="bg-[#f1f4fa] rounded-2xl" />
                                                </div>
                                                <div class="flex-1">
                                                    <LabelComponent Id="yearly" Item="@(VM.AppSetting.TargetYearlySales?.ToString("N0"))" Label="yearly" Style="bg-[#f1f4fa] rounded-2xl" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-white p-3 space-y-3">
                                    <div class="flex-1">
                                        <div class="flex-1 mb-5">
                                            <h1 class="text-2xl font-headline font-extrabold text-gray tracking-tight">Account and email configuration.</h1>
                                            <p class="text-sm text-on-surface-variant">Setings to receive email notification.</p>
                                        </div>
                                        <div class="space-y-2  mb-2">
                                            <LabelComponent Id="email" Item="@VM.AppSetting.GmailAccount" Label="GMAIL account" Style="bg-[#f1f4fa] rounded-2xl" />
                                        </div>
                                        <div class="space-y-2 mb-2">
                                            <SecretCodeComponent ReadOnly="true" Id="gmail-account" @bind-Item="@VM.AppSetting.AppPassword" Label="APP Passcode" PlaceHolder="e.g. 123-334-343-434" Style="bg-[#f1f4fa]" />
                                        </div>
                                        <div class="space-y-2 mb-3 p-1">
                                            <CheckboxComponent Disabled="true" @bind-Item="@VM.AppSetting.ReceiveEmailNotification" Label="Receive email notification" SubLabel="Activate email sending." />
                                        </div>

                                        <div class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-[#dfe3e8]/30 space-y-6">
                                            <div class="flex items-center space-x-4">
                                                <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><line x1="10" y1="9" x2="8" y2="9"></line></svg>
                                                </div>
                                                <h3 class="text-xl font-extrabold text-primary">How to get Gmail appcode?</h3>
                                            </div>

                                            <div class="space-y-0 text-sm text-[#40484c] leading-relaxed">
                                                <p>Step 1. Got https://myaccount.google.com/ and login.</p>
                                                <p>Step 2. Enable 2‑Step Verification.</p>
                                                <p>Step 3. Search for App Passwords.</p>
                                                <p>Step 4. Set JPay as the name of the app.</p>
                                                <p>Step 5. Copy the 16‑Digit Code</p>
                                                <p>Step 6. Paste in App Passcode.</p>
        
                                            </div>

                                            <div class="pt-0">
                                                <div class="p-4 bg-[#f1f4fa] rounded-2xl border border-[#dfe3e8]/30">
                                                    <p class="text-xs font-bold text-[#003345] uppercase tracking-widest mb-1">What is GMAIL appcode?</p>
                                                    <p class="text-xs text-[#40484c]">
                                                        Gmail app code will let you use gmail to send email notification.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 flex justify-end">
@*                         <ButtonComponent Id="btn-category" IsBusy="VM.isBusy" Click="@(() => VM.SaveAppSettings())" ActionText="Save Changes" Style="bg-primary text-white px-6 py-3 rounded-xl font-bold shadow-md hover:shadow-lg hover:bg-primary-container transition-all" /> *@
                    </div>

                </div>
            </main>
        </div>
    
        <OffCanvassComponent Overlay="setting-overlay" Id="setting-component">
            <Content>
                <SettingComponent IsBusy="@VM.IsBusy" Save="@VM.SaveAppSettings" TimeZones="@VM.TimeZones" @bind-AppSetting="@VM.AppSetting" />
            </Content>
        </OffCanvassComponent>
    </PageContent>
</PageComponent>



@code{
    protected override async Task OnInitializedAsync()
    {
        await VM.LoadAppSetting();
        await base.OnInitializedAsync();
        StateHasChanged();
    }
    public void SetDisplay(string display)
    {
        VM.AppSetting.Display = display;
        StateHasChanged();
    }
}
