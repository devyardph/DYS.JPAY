@using DYS.JPay.Shared.Shared.Entities
@using DYS.JPay.Shared.Shared.Settings
@inject IJSRuntime JS

<div class="flex items-center justify-between p-6 border-b border-outline-variant/10 bg-surface-container-low/30">
    <div>
        <h2 id="offcanvas-title" class="text-2xl font-headline font-extrabold text-primary">
           Store settings
        </h2>
 
    </div>
    <button @onclick="@OnCancelAsync" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors text-on-surface-variant">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
</div>

<div class="flex-1 overflow-y-auto p-6 no-scrollbar">
    <form id="canvass-form" class="space-y-3">
        <div class="space-y-1.5">
            <TextComponent Id="name" @bind-Item="@AppSetting.StoreName" Label="Store Name" PlaceHolder="e.g. store name" Style="bg-[#f1f4fa]" />
        </div>
        <div class="space-y-1.5">
            <TextAreaComponent Id="description" @bind-Item="@AppSetting.StoreDescription" Label="Store Description" PlaceHolder="e.g. store description" Style="bg-[#f1f4fa]" />
        </div>
        <div class="space-y-1">
            <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Product display settings</label>
            <div class="flex gap-2">
                <button @onclick="@(() => SetDisplay("grid"))" class="p-3 rounded-xl shadow-lg scale-110 @BooleanExtensions.GetConditionalString(AppSetting.Display == "grid", "bg-[#003345] text-white", "bg-[#f1f4fa] text-[#40484c] hover:bg-[#dfe3e8]")">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="24" height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="lucide lucide-layout-grid w-5 h-5"
                         aria-hidden="true">
                        <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                        <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    </svg>
                </button>
                <button @onclick="@(() => SetDisplay("list"))" class="p-3 rounded-xl @BooleanExtensions.GetConditionalString(AppSetting.Display == "list", "bg-[#003345] text-white", "bg-[#f1f4fa] text-[#40484c] hover:bg-[#dfe3e8]")">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="24" height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="lucide lucide-list w-5 h-5"
                         aria-hidden="true">
                        <path d="M3 5h.01"></path>
                        <path d="M3 12h.01"></path>
                        <path d="M3 19h.01"></path>
                        <path d="M8 5h13"></path>
                        <path d="M8 12h13"></path>
                        <path d="M8 19h13"></path>
                    </svg>
                </button>
            </div>
        </div>
        <div class="space-y-1">
            <label class="text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Currency</label>
            <select @bind="@AppSetting.Currency" 
                    class="w-full bg-[#f1f4fa] border-none rounded-2xl px-5 py-3 text-sm focus:ring-2 focus:ring-primary transition-all">
                @foreach (var currency in GlobalSettings.Currencies.OrderBy(x => x.Name)!)
                {
                    <option value="@currency.DisplayName">@currency.Name - @currency.DisplayName</option>
                }
            </select>
        </div>
        <div class="space-y-1">
            <DoubleComponent Id="tax" Prefix="%" @bind-Item="@AppSetting.Tax" Label="Tax" PlaceHolder="" Style="bg-[#f1f4fa]" />
        </div>
        <div class="space-y-1">
            <div class="flex gap-2">
                <div class="flex-1">
                    <DoubleComponent Id="daily-sales" Prefix="@AppSetting.Currency" @bind-Item="@AppSetting.TargetDailySales" Label="Daily target" PlaceHolder="" Style="bg-[#f1f4fa]" />
                </div>
                <div class="flex-1">
                    <DoubleComponent Id="weekly-sales" Prefix="@AppSetting.Currency" @bind-Item="@AppSetting.TargetWeeklySales" Label="Weekly target" PlaceHolder="" Style="bg-[#f1f4fa]" />
                </div>
            </div>
        </div>
        <div class="space-y-1">
            <div class="flex  gap-2">
                <div class="flex-1">
                    <DoubleComponent Id="montly-sales" Prefix="@AppSetting.Currency" @bind-Item="@AppSetting.TargetMonthlySales" Label="Monthly target" PlaceHolder="" Style="bg-[#f1f4fa]" />
                </div>
                <div class="flex-1">
                    <DoubleComponent Id="yearly-sales" Prefix="@AppSetting.Currency" @bind-Item="@AppSetting.TargetYearlySales" Label="Yearly target" PlaceHolder="" Style="bg-[#f1f4fa]" />
                </div>
            </div>
        </div>
    </form>
</div>

<div class="p-6 border-t border-outline-variant/10 bg-surface-container-lowest flex gap-3 mb-5">
    <ButtonComponent Id="btn-cancel" Click="@OnCancelAsync" ActionText="Cancel" Style="bg-surface-container-highest text-on-surface border-t border-outline-variant/10" />
    <ButtonComponent Disabled="@(!AppSetting.ValidContent())" Id="btn-category" IsBusy="@IsBusy" Click="@OnSaveAsync" ActionText="@ActionText" Style="@ActionStyle" />
</div>

@code {
    [Parameter]
    public string ActionText { get; set; } = "Save settings";
    [Parameter]
    public string ActionStyle { get; set; } = "bg-primary text-white";
    [Parameter]
    public bool IsBusy { get; set; }
    [Parameter]
    public AppSetting AppSetting { get; set; } = new AppSetting();
    [Parameter]
    public EventCallback<AppSetting> AppSettingChanged { get; set; }
    [Parameter]
    public EventCallback Save { get; set; }


    public async Task OnSaveAsync()
    {
        await AppSettingChanged.InvokeAsync(AppSetting);
        await Save.InvokeAsync();
    }

    public void SetDisplay(string display) => AppSetting.Display = display;

    public async Task OnCancelAsync()
    {
        await JS.InvokeVoidAsync("closeOffcanvas", "setting-overlay", "setting-component");
    }
}
