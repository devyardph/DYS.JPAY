@page "/help"
@layout MainLayout
@using DYS.JPay.Shared.Features.Orders.ViewModels
@using DYS.JPay.Shared.Shared.Components
@using DYS.JPay.Shared.Shared.Helpers
@inject IImageService ImageService

 
 
<PageComponent>
    <PageContent>
        <div id="main-content" class="flex-1 lg:ml-64 min-h-screen flex flex-col transition-all duration-300">
            <main class="flex-1 pt-10 px-4 md:px-8 lg:px-12 pb-16 max-w-7xl mx-auto w-full opacity-0 animate-fade-in-up">
                <div class="space-y-4 mb-5">
                    <h2 class="text-4xl font-black text-primary tracking-tight font-headline">Help & Support</h2>
                    <p class="text-on-surface-variant text-lg max-w-2xl">
                        Find answers to common questions or get in touch with our support team.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-outline-variant/10 space-y-6">
                        <div class="flex items-center space-x-4">
                            <div class="p-3 bg-primary/10 rounded-2xl text-primary">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <h3 class="text-xl font-headline font-extrabold text-primary">Frequently Asked Questions</h3>
                        </div>

                        <div class="space-y-6">
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I add a category?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">Categories can be added when creating or editing a product, or from the Settings menu. Simply type the name of the new category and save.</p>
                            </div>
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I add a product?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">Go to the Settings page and navigate to the Products section. Click 'Add Product', fill in the product name, price, category, and image, then click save.</p>
                            </div>
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I add an order?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">In the POS view, tap on the products to add them to the cart. Adjust quantities as needed, then tap 'Charge' to process the payment and complete the order.</p>
                            </div>
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I update a transaction?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">Navigate to the 'Transactions' page. Click on any transaction listed to view its details, where you can update the transaction to 'preparing', 'completed' or 'cancelled'.</p>
                            </div>
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I view a report?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">Click on 'Reports' in the sidebar navigation. You can view sales overview, top products, and other analytics. Use the date filters to customize your view.</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-8">
                        <div class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-outline-variant/10 space-y-6">
                       
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I manage and add users (like a Cashier)?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">Go to the 'Users' page from the sidebar. Click on 'Add User', enter their details, and select 'Cashier' from the role dropdown menu. They will be able to access the POS but not the settings.</p>
                            </div>
                            <div class="space-y-2">
                                <h4 class="font-bold text-primary">How do I change store settings (tax, currency, target sales, etc)?</h4>
                                <p class="text-sm text-on-surface-variant leading-relaxed">Navigate to the 'Settings' page. Under the 'Store Info' and 'Preferences' tabs, you can update your store's name, currency symbol, tax rate, and set your monthly target sales.</p>
                            </div>

                            <div class="space-y-1">
                                <h4 class="font-bold text-primary">How receive email notification?</h4>
                               
                                <p class="text-sm text-on-surface-variant leading-relaxed">
                                    Step 1. Got https://myaccount.google.com/ and login.
                                </p>
                                <p class="text-sm text-on-surface-variant leading-relaxed">
                                    Step 2. Enable 2‑Step Verification.
                                </p>
                                <p class="text-sm text-on-surface-variant leading-relaxed">
                                    Step 3. Search for App Passwords.
                                </p>
                                <p class="text-sm text-on-surface-variant leading-relaxed">
                                    Step 4. Set JPay as the name of the app.
                                </p>
                                <p class="text-sm text-on-surface-variant leading-relaxed">
                                    Step 5. Copy the 16‑Digit Code and paste in app Settings.</p>

                            </div>
                            
                            <div class="flex items-center space-x-4">
                                <div class="p-3 bg-secondary/10 rounded-2xl text-secondary">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                </div>
                                <h3 class="text-xl font-headline font-extrabold text-primary">Contact Support</h3>
                            </div>
                            <p class="text-sm text-on-surface-variant mb-4">
                                Need more help? Our team is available 24/7 to assist you with any technical issues or account questions.
                            </p>
                            <div>
                                <a href="mailto:devyardph@gmail.com" class="w-full ledger-gradient text-white py-4 rounded-2xl font-bold shadow-xl active:scale-[0.98] transition-all">
                                    <button class="w-full ledger-gradient text-white py-4 rounded-2xl font-bold shadow-xl active:scale-[0.98] transition-all">
                                        Email Support
                                    </button>
                                </a>
                            </div>
                        </div>

                        @*             <div class="bg-surface-container-low p-8 rounded-[2.5rem] border border-outline-variant/10 space-y-4">
                <h3 class="text-lg font-headline font-extrabold text-primary">System Status</h3>
                <div class="flex items-center space-x-2">
                    <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                    <span class="text-sm font-bold text-emerald-600">All Systems Operational</span>
                </div>
                <p class="text-xs text-on-surface-variant">
                    Last updated: Just now
                </p>
            </div>
 *@
                    </div>
                </div>
            </main>
        </div>
    </PageContent>
</PageComponent>



