@page "/dashboard"
@using DYS.JPay.Shared.Features.Dashboard.ViewModels
@inject DashboardViewModel VM

<!-- Main Content -->
  <div id="main-content" class="flex-1 lg:ml-64 min-h-screen flex flex-col transition-all duration-300 ">
        <main class="flex-1 pt-10 px-4 md:px-8 lg:px-12 pb-16 max-w-7xl mx-auto w-full opacity-0 space-y-8 animate-fade-in-up">
        <section class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
            <div class="space-y-2">
                <span class="text-[10px] font-bold text-[#004b63] tracking-widest uppercase">Total Monthly Sales</span>
                <h2 class="text-4xl md:text-6xl font-headline font-extrabold text-[#181c20] tracking-tight">
                    @VM.Session.AppSettings.Currency@VM.Dashboard.Completed?.ToString("N2")<span class="text-[#c0c7cd] font-light"></span>
                </h2>
                <div class="flex items-center space-x-2 text-[#016a60] font-medium text-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17" /><polyline points="16 7 22 7 22 13" /></svg>
                    <span>+12.5% from last month</span>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-4">
                <div class="bg-white p-6 rounded-2xl shadow-sm flex-1 sm:min-w-[200px] border border-[#dfe3e8]/10">
                    <p class="text-[#40484c] text-xs font-medium mb-1">PENDING SALES</p>
                    <p class="text-2xl font-headline font-bold text-[#016a60]">@VM.Session.AppSettings.Currency@VM.Dashboard.Pending?.ToString("N2")</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm flex-1 sm:min-w-[200px] border border-[#dfe3e8]/10">
                    <p class="text-[#40484c] text-xs font-medium mb-1">CANCELLED</p>
                    <p class="text-2xl font-headline font-bold text-[#ba1a1a]">@VM.Session.AppSettings.Currency@VM.Dashboard.Cancelled?.ToString("N2")</p>
                </div>
            </div>
        </section>
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-7 bg-[#f1f4fa] p-6 md:p-8 rounded-3xl space-y-8">
                <div class="flex justify-between items-center">
                    <h3 class="font-headline font-bold text-xl text-[#003345]">Sales breakdown</h3>
                    <button class="text-[10px] font-bold text-[#004b63] hover:underline uppercase tracking-wider">Analysis</button>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div class="space-y-6">
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs font-semibold">
                                <span class="text-[#181c20]">Completed sales</span>
                                <span class="text-[#40484c]">@VM.Dashboard.CompletedTotal</span>
                            </div>
                            <div class="pulse-meter-track">
                                <div class="h-full bg-[#004b63]" style="width: 45%"></div>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs font-semibold">
                                <span class="text-[#181c20]">Pending sales</span>
                                <span class="text-[#40484c]">@VM.Dashboard.PendingTotal</span>
                            </div>
                            <div class="pulse-meter-track">
                                <div class="h-full bg-[#016a60]" style="width: 30%"></div>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between text-xs font-semibold">
                                <span class="text-[#181c20]">Cancelled transactions</span>
                                <span class="text-[#40484c]">@VM.Dashboard.CancelledTotal</span>
                            </div>
                            <div class="pulse-meter-track">
                                <div class="h-full bg-[#7fda91]" style="width: 15%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center justify-center">
                        <div class="w-32 h-32 rounded-full border-[12px] border-[#004b63] flex items-center justify-center relative">
                            <div class="text-center">
                                <p class="text-sm font-bold text-[#003345]">@VM.Session.AppSettings.Currency@VM.Dashboard.Completed?.ToString("N2")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 bg-primary p-6 md:p-8 rounded-3xl text-white relative overflow-hidden flex flex-col justify-between min-h-[250px]">
                <div class="relative z-10 space-y-6">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-[10px] font-bold opacity-70 uppercase tracking-widest">Target vs. Sales</p>
                            <h4 class="text-2xl font-headline font-bold">Target monthly sales</h4>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><path d="M5 2h14" /><path d="M5 22h14" /><path d="M15 2v1c0 2.39-1.07 4.59-3 6-1.93-1.41-3-3.61-3-6V2" /><path d="M15 22v-1c0-2.39-1.07-4.59-3-6-1.93 1.41-3 3.61-3 6v1" /></svg>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between items-end">
                            <span class="text-3xl font-headline font-bold">@VM.Session.AppSettings.Currency@VM.Dashboard.Completed?.ToString("N2")</span>
                            <span class="text-xs opacity-80">Target: @VM.Session.AppSettings.Currency@VM.Session.AppSettings.TargetMonthlySales?.ToString("N2")</span>
                        </div>
                        <div class="h-1.5 bg-white/20 rounded-full overflow-hidden">
                            <div class="h-full bg-[#7fda91] w-3/4"></div>
                        </div>
                    </div>
                    <p class="text-sm opacity-90 leading-relaxed font-light">
                        You're 75% of the way to securing the new Chelsea expansion budget. Maintain current spend to reach target by September.
                    </p>
                </div>
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#016a60] opacity-20 rounded-full -mr-16 -mt-16 blur-3xl"></div>
            </div>
        </section>
        <section class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between sm:items-end gap-4">
                <h3 class="font-headline font-bold text-2xl text-[#003345]">Recent Transactions</h3>
               @*  <button class="text-sm font-bold text-[#004b63] flex items-center space-x-1 group w-fit">
                    <span>Export Ledger</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-y-1 transition-transform"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
                </button> *@
            </div>
            <div class="space-y-1">
                <!-- Transaction Item -->
                @if (VM.LatestTransactions.Any())
                {
                    @foreach (var transaction in VM.LatestTransactions!)
                    {
                        <div class="group flex flex-col sm:flex-row sm:items-center justify-between p-4 sm:p-3 hover:bg-[#f1f4fa] rounded-2xl transition-all duration-300 gap-4">
                            <div class="flex items-center space-x-4 sm:space-x-5">
                                <div>
                                    <p class="font-bold text-[#181c20] text-sm sm:text-base">@transaction.CustomerName</p>
                                    <p class="text-[10px] sm:text-xs text-[#40484c]">@transaction.DateOrdered?.FormatDate("dd MMM yyyy hh:mmtt") • @transaction.ReferenceNo</p>
                                </div>
                            </div>
                            <div class="text-left sm:text-right flex sm:flex-col justify-between items-center sm:items-end">
                                <p class="font-headline font-bold text-[#181c20]">@VM.Session.AppSettings.Currency@transaction.Total?.ToString("N2")</p>
                                <p class="text-[10px] font-bold uppercase tracking-tighter text-[#40484c]">@transaction.PaymentMode</p>
                            </div>
                       
                    </div>
                    }
                }
            </div>
        </section>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        VM.Search.StartDate = DateTime.Now.StartOfMonth();
        VM.Search.EndDate = DateTime.Now.EndOfMonth();
        await VM.SearchTransactionsAsync();
        await base.OnInitializedAsync();
    }
}
