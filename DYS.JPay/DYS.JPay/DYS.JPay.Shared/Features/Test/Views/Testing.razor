@page "/testing1"
@layout EmptyLayout
@using DYS.JPay.Shared.Features.Test.ViewModels
@using DYS.JPay.Shared.Shared.Helpers
@inject IJSRuntime JS
@inject TestViewModel VM
@inject IPrinterService PrinterService


<div class="printer-panel">
    <h3>🖨️ Thermal Printer</h3>

    <button @onclick="ScanDevices" disabled="@_scanning">
        @(_scanning ? "Scanning..." : "Scan Devices")
    </button>

    @if (_devices.Any())
    {
        <select @bind="_selectedAddress">
            <option value="">-- Select Printer --</option>
            @foreach (var d in _devices)
            {
                <option value="@d.Address">@d.Name (@d.Address)</option>
            }
        </select>

        <button @onclick="Connect">
            @(PrinterService.IsConnected ? "✅ Connected" : "Connect")
        </button>
    }

    @if (PrinterService?.IsConnected == true)
    {
        <hr />
        <h4>Test Receipt</h4>
        <button @onclick="PrintTestReceipt">🖨️ Print Test</button>
        <button @onclick="Disconnect">Disconnect</button>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="status">@_status</p>
    } 
</div>

@code {
    private List<BluetoothDeviceDto> _devices = new();
    private string _selectedAddress = "";
    private string _status = "";
    private bool _scanning = false;

    private async Task ScanDevices()
    {
        _scanning = true;
        _status = "Scanning...";
        var devices = await PrinterService.ScanDevicesAsync();
        _devices = devices.Entity!;
        _status = $"Found {_devices!.Count} device(s)";
        _scanning = false;
    }

    private async Task Connect()
    {
        _status = "Connecting...";
        //var printerModel = "COM4";//VM.Session.AppSettings.DefaultPrinter;
        var device = _devices?.FirstOrDefault(x => x.Name != null && x.Name.Contains(_selectedAddress));
        if(device!=null)
        {
            var ok = await PrinterService.ConnectAsync(device.Address);
        }
    }

    private async Task Disconnect()
    {
        await PrinterService.DisconnectAsync();
        _status = "Disconnected.";
    }

    private async Task PrintTestReceipt()
    {
        var items = new Dictionary<string, string>
        {
            { "Burger", "₱150.00" },
            { "Fries",  "₱80.00"  },
            { "Coke",   "₱50.00"  }
        };

        var data = EscPosHelper.BuildReceipt("MY STORE", items, "₱280.00");
        var ok = await PrinterService.PrintAsync(data);
        _status = ok ? "Printed!" : "Print failed.";
        await PrinterService.DisconnectAsync();
    }
}
