@using DYS.JPay.Shared.Shared.Entities
@using DYS.JPay.Shared.Shared.Settings
@inject IJSRuntime JS

<div class="flex items-center justify-between p-6 border-b border-outline-variant/10 bg-surface-container-low/30">
    <div>
        <h2 id="offcanvas-title" class="text-2xl font-headline font-extrabold text-primary">
            @BooleanExtensions.GetConditionalString(User.Id.HasValue,"Edit user","New user")
        </h2>
        <p id="offcanvas-subtitle" class="text-sm text-on-surface-variant mt-1">
            @BooleanExtensions.GetConditionalString(User.Id.HasValue, "Edit existing user.", "Create new user listing.")
        </p>
    </div>
    <button @onclick="@OnCancelAsync" class="p-2 hover:bg-surface-container-highest rounded-full transition-colors text-on-surface-variant">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
</div>

<div class="flex-1 overflow-y-auto p-6 no-scrollbar">
    <form id="canvass-form" onsubmit="event.preventDefault(); closeOffcanvas();" class="space-y-3">
        <div class="space-y-1">
            <TextComponent Id="name" @bind-Item="@User.Name" Label="Full Name" PlaceHolder="e.g. full name" />
        </div>
        <div class="space-y-1">
            <TextComponent Id="username" @bind-Item="@User.Username" Label="User Name" PlaceHolder="e.g. username" />
        </div>
        <div class="space-y-1">
            <PasswordComponent Id="pass-code" @bind-Item="@User.Code" Label="Pass code - 6-digit code" PlaceHolder="e.g. 123456" />
        </div>
        <div class="space-y-1">
            <TextComponent Id="email" @bind-Item="@User.Email" Label="Email address" PlaceHolder="e.g. email@gmail.com" />
        </div>
        <div class="space-y-1">
            <label class="text-xs text-on-surface-variant uppercase tracking-wider pl-1">ROLE ASSIGNMENT</label>
            <select @bind="User.Role"
                    class="w-full bg-surface-container-low border-none rounded-2xl px-5 py-2 text-sm focus:ring-2 focus:ring-primary transition-all">
                <option value="@GlobalSettings.CASHIER">@GlobalSettings.CASHIER</option>
                <option value="@GlobalSettings.ADMIN">@GlobalSettings.ADMIN</option>
                <option value="@GlobalSettings.GUEST">@GlobalSettings.GUEST</option>
                <option value="@GlobalSettings.OWNER">@GlobalSettings.OWNER</option>
            </select>
        </div>
        <div class="space-y-2">
            <CheckboxComponent Visible="true" @bind-Item="@User.Active" Label="User status" SubLabel="Set if active or inactive." />
        </div>
        <div class="space-y-2">
            <CheckboxComponent Visible="@(User.Id != null && User.Role != GlobalSettings.ADMIN)" ItemTriggered="@ConfirmDeletionAsync" @bind-Item="@User.IsDeleted" Label="Soft delete" SubLabel="Soft delete category." />
        </div>
    </form>
</div>

<div class="p-6 border-t border-outline-variant/10 bg-surface-container-lowest flex gap-3 mb-5">
    <ButtonComponent Id="btn-cancel" Click="@OnCancelAsync" ActionText="Cancel" Style="bg-surface-container-highest text-on-surface border-t border-outline-variant/10" />
    <ButtonComponent Id="btn-category" IsBusy="@IsBusy" Click="@OnSaveAsync" ActionText="@ActionText" Style="@ActionStyle" />
</div>

@code {
    [Parameter]
    public string ActionText { get; set; } = "Save user";
    [Parameter]
    public string ActionStyle { get; set; } = "bg-primary text-white";
    [Parameter]
    public bool IsBusy { get; set; }
    [Parameter]
    public UserDto User { get; set; } = new UserDto();
    [Parameter]
    public EventCallback<UserDto> UserChanged { get; set; } 
    [Parameter]
    public EventCallback Save { get; set; }

    public async Task OnSaveAsync()
    {
        await UserChanged.InvokeAsync(User);
        await Save.InvokeAsync();
        await JS.InvokeVoidAsync("trigger", "btn-search");
        Initialize();
    }

    public async Task OnCancelAsync()
    {
        await JS.InvokeVoidAsync("closeOffcanvas", "user-overlay", "user-component");
        await JS.InvokeVoidAsync("trigger", "btn-search");
        Initialize();
    }

    public async Task ConfirmDeletionAsync(bool delete)
    {
        if (delete)
        {
            ActionText = "Confirm deletion";
            ActionStyle = "bg-red-500 text-white";
        }
        else Initialize();
    }

    public void Initialize()
    {
        ActionText = "Save user";
        ActionStyle = "bg-primary text-white";
    }
}
