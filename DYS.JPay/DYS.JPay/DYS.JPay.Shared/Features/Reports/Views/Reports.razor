@page "/reports"
@using DYS.JPay.Shared.Features.Orders.ViewModels
@using DYS.JPay.Shared.Features.Reports.Components
@using DYS.JPay.Shared.Features.Transactions.Components
@using DYS.JPay.Shared.Shared.Components
@using DYS.JPay.Shared.Shared.Extensions
@using Microsoft.AspNetCore.Authorization
@using DYS.JPay.Shared.Shared.Helpers
@inject IJSRuntime JS
@inject ReportViewModel VM

 
<PageComponent>
    <PageContent>
        
        <div id="main-content" class="flex-1 lg:ml-64 min-h-screen flex flex-col transition-all duration-300 ">
            <main class="flex-1 pt-10 px-4 md:px-8 lg:px-12 pb-16 max-w-7xl mx-auto w-full opacity-0 space-y-8 animate-fade-in-up">

                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                    <div>
                        <h1 class="text-3xl font-headline font-extrabold text-primary tracking-tight">Sales Report</h1>
                        <p class="text-sm text-on-surface-variant">Monitoring sales report.</p>
           
                    </div>
                    <div class="flex gap-3">
                        <ButtonComponent Id="btn-completed" IsBusy="@VM.IsBusy" Click="@VM.OpenSendEmail" ActionText="Send to email" Style="bg-primary text-white">
                            <SVGIcon>
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
                            </SVGIcon>
                        </ButtonComponent>
                    </div>
                  
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-[1rem] shadow-sm border border-[#dfe3e8]/30 space-y-2">
                        <p class="text-xs text-[#40484c] uppercase tracking-widest opacity-70">Total sales</p>
                        <p class="text-3xl font-black text-emerald-600" id="total-income">@VM.Session.AppSettings.Currency@VM.Dashboard.Completed?.ToString("N2")</p>
                    </div>
                    <div class="bg-white p-6 rounded-[1rem] shadow-sm border border-[#dfe3e8]/30 space-y-2">
                        <p class="text-xs text-[#40484c] uppercase tracking-widest opacity-70">Pending Sales</p>
                        <p class="text-3xl font-black text-[#003345]" id="net-savings">@VM.Session.AppSettings.Currency@VM.Dashboard.Pending?.ToString("N2")</p>
                    </div>
                    <div class="bg-white p-6 rounded-[1rem] shadow-sm border border-[#dfe3e8]/30 space-y-2">
                        <p class="text-xs text-[#40484c] uppercase tracking-widest opacity-70">Cancelled</p>
                        <p class="text-3xl font-black text-rose-600" id="total-expenses">@VM.Session.AppSettings.Currency@VM.Dashboard.Cancelled?.ToString("N2")</p>
                    </div>
                   
                </div>

                <div class="bg-[#f1f4fa] p-4 md:p-6 rounded-2xl flex flex-col md:flex-row flex-wrap gap-4 items-stretch md:items-end shadow-sm border border-[#dfe3e8]/50">
                    <!-- Search keyword -->
                    <div class="flex-grow min-w-0 sm:min-w-[300px]">
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-[#40484c] mb-2">Search transactions</label>
                        <div class="relative">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-[#40484c]">
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.3-4.3" />
                            </svg>
                            <input @bind-value="@VM.Search.Keyword" type="text" placeholder="Name, payment mode, status ,reference no..." class="w-full bg-white border-none rounded-xl pl-10 py-2 text-sm shadow-sm focus:ring-1 focus:ring-[#003345]">
                        </div>
                    </div>

                    <!-- Start Date -->
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-[#40484c] mb-2">Start Date</label>
                        <input @bind-value="@VM.Search.StartDate" type="date" class="bg-white border-none rounded-xl px-3 py-2 text-sm shadow-sm focus:ring-1 focus:ring-[#003345]">
                    </div>

                    <!-- End Date -->
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-[#40484c] mb-2">End Date</label>
                        <input @bind-value="@VM.Search.EndDate" type="date" class="bg-white border-none rounded-xl px-3 py-2 text-sm shadow-sm focus:ring-1 focus:ring-[#003345]">
                    </div>

                    <!-- Search button -->
                    <button id="btn-search" @onclick="@(() => VM.SearchTransactionsAsync())"
                            class="bg-[#dfe3e8] text-[#003345] text-sm font-bold px-6 py-2 rounded-xl flex items-center justify-center gap-2">
                        Search
                    </button>
                </div>

                <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-[#dfe3e8]/80">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px] table-hover">
                            <thead>
                                <tr class="bg-[#f1f4fa]">
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Customer name</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">TXN Code</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Payment mode</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Total</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Count</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Transaction date</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c]">Status</th>
                                    <th class="px-4 py-4 text-[10px] font-bold uppercase tracking-widest text-[#40484c] text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @if (VM?.isBusy == true)
                                {
                                    @for (int i = 0; i < 50; i++)
                                    {
                                        <tr class="hover:bg-surface-container-low/50 transition-colors group">
                                            <td class="px-3 py-2">
                                                <div class="flex items-center gap-3">
                                                    <div class="size-10 rounded-full bg-gray-200"></div>
                                                    <div class="flex-1 space-y-2 py-1">
                                                        <div class="space-y-3">
                                                            <div class="grid grid-cols-3 gap-4">
                                                                <div class="col-span-2 h-2 rounded bg-gray-200"></div>
                                                            </div>
                                                            <div class="h-2 rounded bg-gray-200"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                <div class="h-2 rounded bg-gray-200"></div>
                                            </td>
                                            <td class="px-3 py-2 text-sm font-medium text-[#181c20]">
                                                <div class="h-2 rounded bg-gray-200"></div>
                                            </td>
                                            <td class="px-3 py-2 text-right font-bold text-[#016a60]">
                                                <div class="h-2 rounded bg-gray-200"></div>
                                            </td>
                                            <td class="px-6 py-2 text-right gap-5">
                                                <div class="col-span-2 h-2 rounded bg-gray-200"></div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    @foreach (var transaction in VM?.Transactions!)
                                    {
                                        <tr class="hover:bg-surface-container-low/50 transition-colors group">
                                            <td class="px-3 py-2">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm">
                                                        @transaction.CustomerName.FirstLetter()
                                                    </div>
                                                    <div>
                                                        <p class="text-sm font-bold text-gray-900">@transaction.CustomerName</p>
                                                        <p class="text-xs text-gray-500">@transaction.Cashier</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-3 py-2 text-sm font-medium text-[#181c20]">
                                                @transaction.Code
                                            </td>
                                            <td class="px-3 py-2 text-sm font-medium text-[#181c20]">
                                                @transaction.PaymentMode?.ToUpper()
                                            </td>
                                            <td class="px-3 py-2 text-sm font-medium text-[#181c20]">
                                                @VM.Session.AppSettings.Currency@transaction.Total?.ToString("N2")
                                            </td>
                                            <td class="px-3 py-2 text-sm font-medium text-[#181c20]">
                                                @transaction.Count
                                            </td>
                                            <td class="px-3 py-2 text-sm font-medium text-[#181c20]">
                                                @DataExtensions.GetTransactionDate(transaction).ToLocalTime().FormatDate("dd MMM yyyy hh:mmtt")
                                            </td>
                                            <td class="px-3 py-2">
                                                <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-[@DataExtensions.GetTransactionStatus(@transaction.Status)?.BackgroundColor] text-[@DataExtensions.GetTransactionStatus(@transaction.Status)?.TextColor]">@transaction.Status</span>
                                             </td>
                                            <td class="px-6 py-2 text-right">
                                                <button @onclick="@(() => VM.OpenReport(transaction))" class="p-2 hover:bg-primary/10 text-primary rounded-xl transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-5 h-5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </main>
        </div>

        <OffCanvassComponent Overlay="report-overlay" Id="report-component">
            <Content>
                <ReportComponent 
                    IsBusy="VM.isProcessing"
                    @bind-Transaction="@VM.Transaction" 
                    Orders="@VM.Orders"
                    Currency="@VM.Session.AppSettings.Currency"/> 
            </Content>
        </OffCanvassComponent>
        <EmailComponent Id="email-modal" Email="@VM.Email" IsBusy="VM.IsProcessing" SendReport="@VM.SendReport" />
        <ResultComponent Id="result-modal" Notification="@VM.Notification"/>
    </PageContent>
</PageComponent>

@code{
    protected override async Task OnInitializedAsync()
    {
        VM.Search.StartDate = DateTime.Now.StartOfMonth();
        VM.Search.EndDate = DateTime.Now.EndOfMonth();
        VM.Email = new EmailDto() { Subject = "Generated Sales Report", Email = VM.Session.CurrentUser.Email };
        await VM.SearchTransactionsAsync();
        await base.OnInitializedAsync();
    }
}
